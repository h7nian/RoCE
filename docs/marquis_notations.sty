\newtheorem*{theoremstar}{Theorem \thmstarnumber}

\makeatletter
\newenvironment{theorem*}[1]
 {\edef\thmstarnumber{\getrefnumber{#1}*}%
  \let\@currentlabel\thmstarnumber\theoremstar}
 {\endtheoremstar}
\makeatother

\makeatletter
\newenvironment{theoremRep}[1]
 {\edef\thmstarnumber{\getrefnumber{#1}}%
  \let\@currentlabel\thmstarnumber\theoremstar}
 {\endtheoremstar}
\makeatother

\newtheorem*{lemmastar}{Lemma \lemmastarnumber}

\makeatletter
\newenvironment{lemma*}[1]
 {\edef\lemmastarnumber{\getrefnumber{#1}*}%
  \let\@currentlabel\lemmastarnumber\lemmastar}
 {\endlemmastar}
\makeatother

\makeatletter
\newenvironment{lemmaRep}[1]
 {\edef\lemmastarnumber{\getrefnumber{#1}}%
  \let\@currentlabel\lemmastarnumber\lemmastar}
 {\endlemmastar}
\makeatother

