\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{roce_common}[2026/04/16 RoCE shared macros for main.tex and supplemental.tex]

% Expectation / variance / covariance operators
\DeclareMathOperator{\E}{\mathbb{E}}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}

% Empirical average
\providecommand{\tildeE}{\widetilde{E}}

% Basic number set
\providecommand{\R}{\mathbb{R}}

% Probabilistic order symbols
\providecommand{\op}{o_p}
\providecommand{\Op}{O_p}

% Bold Greek / covariate vectors
\providecommand{\bX}{\boldsymbol{X}}
\providecommand{\balpha}{\boldsymbol{\alpha}}
\providecommand{\bgamma}{\boldsymbol{\gamma}}
\providecommand{\bbeta}{\boldsymbol{\beta}}
\providecommand{\bhat}[1]{\widehat{\boldsymbol{#1}}}

% Shared theorem-like environments (used by both main.tex and supplemental.tex).
% Centralised here so the two documents stay consistent; amsthm is required
% rather than re-loaded so standalone supplemental compilation is unaffected.
\RequirePackage{amsthm}
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}{Lemma}
\newtheorem{corollary}{Corollary}
\newtheorem{proposition}{Proposition}
\theoremstyle{definition}
\newtheorem{definition}{Definition}
\newtheorem{assumption}{Assumption}
\theoremstyle{remark}
\newtheorem{remark}{Remark}

% Compatibility shim for the proof-at-the-end package's restated-theorem
% environment (\begin{theoremRep}{<label-of-original>}). That package is not a
% dependency here; the single use restates an already-stated theorem, so render
% it as an unnumbered "(restated)" block and consume the mandatory label arg.
\theoremstyle{plain}
\newtheorem*{theoremRepInner}{Theorem (restated)}
\newenvironment{theoremRep}[1]{\begin{theoremRepInner}}{\end{theoremRepInner}}

\makeatletter
% Enlarged plot labels can extend close to the graphic boundary.  Apply one
% shared figure-to-caption gap after the caption package has been loaded so
% main and supplemental figures remain legible without per-figure overrides.
\AtBeginDocument{%
  \@ifpackageloaded{caption}{\captionsetup[figure]{skip=10pt}}{}%
}

\newcommand{\RoCEResetSupplementCounters}{%
  \setcounter{equation}{0}%
  \setcounter{figure}{0}%
  \setcounter{table}{0}%
  \setcounter{theorem}{0}%
  \setcounter{lemma}{0}%
  \setcounter{corollary}{0}%
  \setcounter{proposition}{0}%
  \setcounter{definition}{0}%
  \setcounter{assumption}{0}%
  \setcounter{remark}{0}%
  \renewcommand{\theequation}{S\arabic{equation}}%
  \renewcommand{\thefigure}{S\arabic{figure}}%
  \renewcommand{\thetable}{S\arabic{table}}%
  \renewcommand{\thetheorem}{S\arabic{theorem}}%
  \renewcommand{\thelemma}{S\arabic{lemma}}%
  \renewcommand{\thecorollary}{S\arabic{corollary}}%
  \renewcommand{\theproposition}{S\arabic{proposition}}%
  \renewcommand{\thedefinition}{S\arabic{definition}}%
  \renewcommand{\theassumption}{S\arabic{assumption}}%
  \renewcommand{\theremark}{S\arabic{remark}}%
  \@ifundefined{theHequation}{}{%
    \renewcommand{\theHequation}{supp.equation.\arabic{equation}}%
  }%
  \@ifundefined{theHfigure}{}{%
    \renewcommand{\theHfigure}{supp.figure.\arabic{figure}}%
  }%
  \@ifundefined{theHtable}{}{%
    \renewcommand{\theHtable}{supp.table.\arabic{table}}%
  }%
  \@ifundefined{theHtheorem}{}{%
    \renewcommand{\theHtheorem}{supp.theorem.\arabic{theorem}}%
  }%
  \@ifundefined{theHlemma}{}{%
    \renewcommand{\theHlemma}{supp.lemma.\arabic{lemma}}%
  }%
  \@ifundefined{theHcorollary}{}{%
    \renewcommand{\theHcorollary}{supp.corollary.\arabic{corollary}}%
  }%
  \@ifundefined{theHproposition}{}{%
    \renewcommand{\theHproposition}{supp.proposition.\arabic{proposition}}%
  }%
  \@ifundefined{theHdefinition}{}{%
    \renewcommand{\theHdefinition}{supp.definition.\arabic{definition}}%
  }%
  \@ifundefined{theHassumption}{}{%
    \renewcommand{\theHassumption}{supp.assumption.\arabic{assumption}}%
  }%
  \@ifundefined{theHremark}{}{%
    \renewcommand{\theHremark}{supp.remark.\arabic{remark}}%
  }%
  \@ifundefined{c@algorithm}{}{%
    \setcounter{algorithm}{0}%
    \renewcommand{\thealgorithm}{S\arabic{algorithm}}%
    \@ifundefined{theHalgorithm}{}{%
      \renewcommand{\theHalgorithm}{supp.algorithm.\arabic{algorithm}}%
    }%
  }%
}
\makeatother

\endinput
