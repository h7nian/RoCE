% Main-text statements are shared with their unnumbered restatements.
% A standalone supplement imports main labels with the prefix main-.
\ifcsname ifFACEHDSTANDALONE\endcsname\else
  \expandafter\newif\csname ifFACEHDSTANDALONE\endcsname
\fi
\newcommand{\FACEHDAddMainLabel}[1]{%
  \ifx\FACEHDMainLabels\empty
    \edef\FACEHDMainLabels{main-#1}%
  \else
    \edef\FACEHDMainLabels{\FACEHDMainLabels,main-#1}%
  \fi}
\DeclareRobustCommand{\maincref}[1]{%
  \ifFACEHDSTANDALONE
    \begingroup
    \let\FACEHDMainLabels\empty
    \forcsvlist{\FACEHDAddMainLabel}{#1}%
    \expandafter\cref\expandafter{\FACEHDMainLabels}%
    \endgroup
  \else
    \cref{#1}%
  \fi}
\newif\ifFACEHDRestating
\newcommand{\FACEHDMainEquation}[2]{%
  \ifFACEHDRestating
    \[#2\]%
  \else
    \begin{equation}\label{#1}#2\end{equation}%
  \fi}
\theoremstyle{plain}
\newtheorem*{mainresultrestated}{\FACEHDRestatedName}
\newenvironment{restatedmain}[1]
  {\FACEHDRestatingtrue\def\FACEHDRestatedName{\maincref{#1}}%
   \begin{mainresultrestated}[restated]}
  {\end{mainresultrestated}}
\theoremstyle{remark}
\input{face_hd_results.tex}

