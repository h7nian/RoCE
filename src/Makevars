# Package-level C++ compile flags for RoCE.
#
# The template-heavy weight optimizer can produce very large DWARF sections;
# -g1 retains symbol names while limiting debug metadata. OpenMP accelerates
# independent nuisance-CV folds. Deployment-specific assembler workarounds
# (including MSI's old-linker relocation flag) belong in the user's Makevars,
# not in the portable package source.

PKG_CXXFLAGS = -g1 $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)
